def sourceDF(DF, filename, schema):

  deltaDF = (spark.read
      .format('delta')
      .load("s3a://Veeva/PT/%s" %filename)
      )
  
  DF_ct  = DF.count()
  deltaDF_ct = deltaDF.count()

  return deltaDF, "Original %s count: %s, Delta table count: %s, counts equal: %s" %(filename, DF_ct, deltaDF_ct, deltaDF_ct==DF_ct)

